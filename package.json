{
  "name": "weekmeal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "predev": "npm run check:node",
    "dev": "vite",
    "dev:docker": "docker run --rm -u 1000:1000 -v \"$PWD:/app\" -w /app -p 5173:5173 node:22 npm run dev -- --host 0.0.0.0",
    "prebuild": "npm run check:node",
    "build": "tsc -b && vite build",
    "build:docker": "docker run --rm -u 1000:1000 -v \"$PWD:/app\" -w /app node:22 npm run build",
    "prepreview": "npm run check:node",
    "preview": "vite preview",
    "docker:install": "docker run --rm -u 1000:1000 -v \"$PWD:/app\" -w /app node:22 npm install",
    "convert:mext": "python3 scripts/convert-mext-foods.py /tmp/mext-food.xlsx src/data/foods.json --select scripts/food-selection.json",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
